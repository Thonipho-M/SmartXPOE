@page "/network-topology"
@inject SmartX.Client.Services.SensorApiClient SensorApi
@* UI layout created with ChatGPT assistance and reviewed by Thonipho Mavhungu. *@

<PageTitle>Network Topology</PageTitle>

<div class="py-4">
    <p class="text-uppercase text-primary fw-semibold mb-2">Final POE workspace</p>
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h1>Network Topology and Mesh Routing</h1>
            <p class="lead text-secondary mb-0">Explore the active Smart-X mesh by device ID or MAC address, then inspect its wireless connections.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadTopologyAsync" disabled="@isLoading">Refresh topology</button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (isLoading)
    {
        <p class="text-secondary">Loading mesh network…</p>
    }
    else
    {
        <section class="row g-3 mb-4" aria-label="Network summary">
            <div class="col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body"><span class="text-secondary">Mesh nodes</span><div class="display-6">@topology.Nodes.Count</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body"><span class="text-secondary">Online nodes</span><div class="display-6 text-success">@topology.Nodes.Count(node => node.IsOnline)</div></div></div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body"><span class="text-secondary">Wireless links</span><div class="display-6">@topology.Links.Count(link => link.IsActive)</div></div></div>
            </div>
        </section>

        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h4">Active mesh map</h2>
                <p class="text-secondary">Each line represents a wireless hop. Link labels show the routing cost used by the connectivity and routing algorithms.</p>
                <div class="table-responsive">
                    <svg viewBox="0 0 720 340" role="img" aria-label="Smart-X mesh network topology" style="min-width: 680px; background: #f8f6ee;">
                        @foreach (var link in topology.Links)
                        {
                            var from = GetMeshPosition(link.FromDeviceId);
                            var to = GetMeshPosition(link.ToDeviceId);
                            <line x1="@from.X" y1="@from.Y" x2="@to.X" y2="@to.Y" stroke="@(link.IsActive ? "#8b6f47" : "#9ca3af")" stroke-width="3"><title>Routing cost: @link.RoutingCost</title></line>
                        }
                        @foreach (var node in topology.Nodes)
                        {
                            var point = GetMeshPosition(node.DeviceId);
                            var fill = node.IsOnline ? "#2f6b3b" : "#6b7280";
                            <circle cx="@point.X" cy="@point.Y" r="@(node.Role == MeshNodeRole.Gateway ? 21 : 16)" fill="@fill"><title>@node.DeviceId · @node.Role · @(node.IsOnline ? "Online" : "Offline")</title></circle>
                        }
                    </svg>
                </div>
                <p class="small text-secondary mb-0 mt-2">Green = online · Grey = offline · Hover or focus a line for its routing cost.</p>
            </div>
        </section>
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 flex-wrap mb-3">
                    <div>
                        <h2 class="h4 mb-1">Mesh connectivity check</h2>
                        <p class="text-secondary mb-0">BFS follows active links from the selected node to reveal reachable, isolated, and offline devices.</p>
                    </div>
                    <button class="btn btn-primary" @onclick="LoadConnectivityAsync" disabled="@isCheckingConnectivity">Analyse connectivity</button>
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label" for="startingNode">Starting node</label>
                        <select id="startingNode" class="form-select" @bind="startingDeviceId">
                            @foreach (var node in topology.Nodes.Where(node => node.IsOnline))
                            {
                                <option value="@node.DeviceId">@node.DeviceId (@node.Role)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="simulationNode">Failure simulation</label>
                        <div class="input-group">
                            <select id="simulationNode" class="form-select" @bind="simulationDeviceId">
                                @foreach (var node in topology.Nodes.Where(node => node.Role != MeshNodeRole.Gateway))
                                {
                                    <option value="@node.DeviceId">@node.DeviceId — @(node.IsOnline ? "Online" : "Offline")</option>
                                }
                            </select>
                            <button class="btn btn-outline-danger" @onclick="ToggleSelectedNodeAsync" disabled="@isUpdatingNode">Toggle status</button>
                        </div>
                    </div>
                </div>

                @if (connectivityMessage is not null)
                {
                    <div class="alert alert-info mt-3 mb-0">@connectivityMessage</div>
                }

                @if (connectivityReport is not null)
                {
                    <div class="row g-3 mt-1">
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block text-success">Reachable</strong><span class="display-6">@connectivityReport.ReachableNodes.Count</span><small class="d-block text-secondary">Devices reached by BFS</small></div></div>
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block text-warning">Isolated online</strong><span class="display-6">@connectivityReport.UnreachableOnlineNodes.Count</span><small class="d-block text-secondary">Online but no route found</small></div></div>
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block text-secondary">Offline</strong><span class="display-6">@connectivityReport.OfflineNodes.Count</span><small class="d-block text-secondary">Simulated or unavailable nodes</small></div></div>
                    </div>
                }
            </div>
        </section>
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 flex-wrap mb-3">
                    <div>
                        <h2 class="h4 mb-1">Power-efficient routing plan</h2>
                        <p class="text-secondary mb-0">Prim's algorithm uses a priority queue to select the lowest-cost active mesh links.</p>
                    </div>
                    <button class="btn btn-success" @onclick="LoadMinimumSpanningTreeAsync" disabled="@isCalculatingTree">Calculate efficient route</button>
                </div>

                @if (treeMessage is not null)
                {
                    <div class="alert alert-info">@treeMessage</div>
                }

                @if (minimumSpanningTree is not null)
                {
                    <div class="row g-3 mb-3">
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block text-success">Total routing cost</strong><span class="display-6">@minimumSpanningTree.TotalRoutingCost</span><small class="d-block text-secondary">Lower cost is more power-efficient</small></div></div>
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block">Selected hops</strong><span class="display-6">@minimumSpanningTree.SelectedLinks.Count</span><small class="d-block text-secondary">Links used by the MST</small></div></div>
                        <div class="col-md-4"><div class="border rounded p-3 h-100"><strong class="d-block text-warning">Unconnected online nodes</strong><span class="display-6">@minimumSpanningTree.UnconnectedDeviceIds.Count</span><small class="d-block text-secondary">No active route to the tree</small></div></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>From</th><th>To</th><th>Routing cost</th></tr></thead>
                            <tbody>
                                @foreach (var link in minimumSpanningTree.SelectedLinks)
                                {
                                    <tr><td>@link.FromDeviceId</td><td>@link.ToDeviceId</td><td>@link.RoutingCost</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between gap-3 flex-wrap mb-3">
                    <div>
                        <h2 class="h4 mb-1">Historical telemetry range</h2>
                        <p class="text-secondary mb-0">Query timestamped data efficiently with the Binary Search Tree.</p>
                    </div>
                    <button class="btn btn-outline-primary" @onclick="LoadTelemetryRangeAsync" disabled="@isLoadingHistory">Find readings</button>
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label" for="historyDevice">Device</label>
                        <select id="historyDevice" class="form-select" @bind="historyDeviceId">
                            @foreach (var node in topology.Nodes.Where(node => node.Role != MeshNodeRole.Gateway))
                            {
                                <option value="@node.DeviceId">@node.DeviceId</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="historyStart">From</label>
                        <input id="historyStart" class="form-control" type="datetime-local" @bind="historyStartUtc" @bind:format="yyyy-MM-ddTHH:mm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="historyEnd">To</label>
                        <input id="historyEnd" class="form-control" type="datetime-local" @bind="historyEndUtc" @bind:format="yyyy-MM-ddTHH:mm" />
                    </div>
                </div>

                @if (historyMessage is not null)
                {
                    <div class="alert alert-info mt-3 mb-0">@historyMessage</div>
                }

                @if (historyReadings.Count > 0)
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Timestamp</th><th>Metric</th><th>Value</th><th>Value type</th></tr></thead>
                            <tbody>
                                @foreach (var reading in historyReadings)
                                {
                                    <tr><td>@reading.RecordedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@reading.MetricName</td><td>@reading.Value</td><td>@reading.ValueType</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h4">Find a mesh device</h2>
                <p class="text-secondary">Search by Smart-X device ID, unique MAC address, location, or node role.</p>
                <input class="form-control" @bind="searchText" placeholder="Example: FARM-MOIST-01 or AA:BB:CC:00:00:01" />
            </div>
        </section>

        <section class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h4">Active mesh devices</h2>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Device</th><th>MAC address</th><th>Role</th><th>Location</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var node in FilteredNodes)
                            {
                                <tr>
                                    <td class="fw-semibold">@node.DeviceId</td>
                                    <td><code>@node.MacAddress</code></td>
                                    <td>@node.Role</td>
                                    <td>@node.Location</td>
                                    <td><span class="badge @(node.IsOnline ? "text-bg-success" : "text-bg-secondary")">@(node.IsOnline ? "Online" : "Offline")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4">Wireless mesh connections</h2>
                <p class="text-secondary">Lower routing cost means a more power-efficient hop.</p>
                <ul class="list-group list-group-flush">
                    @foreach (var link in topology.Links)
                    {
                        <li class="list-group-item d-flex justify-content-between gap-3 flex-wrap">
                            <span><strong>@link.FromDeviceId</strong> ↔ <strong>@link.ToDeviceId</strong></span>
                            <span class="text-secondary">Cost: @link.RoutingCost · @(link.IsActive ? "Active" : "Unavailable")</span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
</div>

@code {
    private NetworkTopologySnapshot topology = new();
    private bool isLoading = true;
    private string searchText = string.Empty;
    private string? errorMessage;
    private NetworkConnectivityReport? connectivityReport;
    private string startingDeviceId = "SMARTX-GATEWAY-01";
    private string simulationDeviceId = "FARM-PUMP-01";
    private bool isCheckingConnectivity;
    private bool isUpdatingNode;
    private string? connectivityMessage;
    private MinimumSpanningTreeResult? minimumSpanningTree;
    private bool isCalculatingTree;
    private string? treeMessage;
    private string historyDeviceId = "FARM-MOIST-01";
    private DateTime historyStartUtc = DateTime.UtcNow.AddHours(-4);
    private DateTime historyEndUtc = DateTime.UtcNow;
    private List<CommandStreamTelemetry> historyReadings = [];
    private bool isLoadingHistory;
    private string? historyMessage;

    private IEnumerable<MeshNetworkNode> FilteredNodes => topology.Nodes.Where(node =>
        string.IsNullOrWhiteSpace(searchText) ||
        node.DeviceId.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        node.MacAddress.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        node.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        node.Role.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadTopologyAsync();

    private async Task LoadTopologyAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            topology = await SensorApi.GetNetworkTopologyAsync();
        }
        catch
        {
            errorMessage = "The network topology could not be loaded. Start the Smart-X API and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadConnectivityAsync()
    {
        isCheckingConnectivity = true;
        connectivityMessage = null;

        try
        {
            connectivityReport = await SensorApi.GetNetworkConnectivityAsync(startingDeviceId);
        }
        catch
        {
            connectivityMessage = "The connectivity report could not be loaded. Start the Smart-X API and try again.";
        }
        finally
        {
            isCheckingConnectivity = false;
        }
    }

    private async Task ToggleSelectedNodeAsync()
    {
        var selectedNode = topology.Nodes.FirstOrDefault(node =>
            node.DeviceId.Equals(simulationDeviceId, StringComparison.OrdinalIgnoreCase));

        if (selectedNode is null)
        {
            connectivityMessage = "Choose a valid mesh node before running the simulation.";
            return;
        }

        isUpdatingNode = true;
        connectivityMessage = null;

        try
        {
            using var response = await SensorApi.UpdateMeshNodeStatusAsync(
                selectedNode.DeviceId,
                !selectedNode.IsOnline);

            if (!response.IsSuccessStatusCode)
            {
                connectivityMessage = "The node status could not be updated.";
                return;
            }

            connectivityMessage = selectedNode.IsOnline
                ? $"{selectedNode.DeviceId} is now offline. Run BFS to inspect the remaining routes."
                : $"{selectedNode.DeviceId} is back online.";
            await LoadTopologyAsync();
            await LoadConnectivityAsync();
        }
        catch
        {
            connectivityMessage = "The node simulation could not be completed. Start the Smart-X API and try again.";
        }
        finally
        {
            isUpdatingNode = false;
        }
    }

    private async Task LoadMinimumSpanningTreeAsync()
    {
        isCalculatingTree = true;
        treeMessage = null;

        try
        {
            minimumSpanningTree = await SensorApi.GetMinimumSpanningTreeAsync(startingDeviceId);
            treeMessage = $"Efficient route calculated from {minimumSpanningTree.StartingDeviceId}.";
        }
        catch
        {
            treeMessage = "The routing plan could not be calculated. Start the Smart-X API and try again.";
        }
        finally
        {
            isCalculatingTree = false;
        }
    }

    private async Task LoadTelemetryRangeAsync()
    {
        if (historyStartUtc > historyEndUtc)
        {
            historyMessage = "Choose a start time that is before the end time.";
            historyReadings = [];
            return;
        }

        isLoadingHistory = true;
        historyMessage = null;

        try
        {
            historyReadings = await SensorApi.GetTelemetryRangeAsync(
                historyDeviceId,
                historyStartUtc,
                historyEndUtc);
            historyMessage = $"{historyReadings.Count} reading(s) returned from the timestamp search tree.";
        }
        catch
        {
            historyReadings = [];
            historyMessage = "The historical query could not be loaded. Start the Smart-X API and try again.";
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private static (int X, int Y) GetMeshPosition(string deviceId) => deviceId switch
    {
        "SMARTX-GATEWAY-01" => (360, 45),
        "FARM-PUMP-01" => (180, 120),
        "GRID-RELAY-01" => (540, 120),
        "GREENHOUSE-HUMID-01" => (650, 210),
        "FARM-VALVE-01" => (100, 220),
        "FARM-MOIST-01" => (220, 290),
        "FARM-TEMP-02" => (300, 220),
        "FARM-PH-01" => (360, 300),
        "GRID-METER-01" => (500, 250),
        _ => (360, 170)
    };
}
