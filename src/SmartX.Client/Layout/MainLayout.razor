@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="text-secondary">Thonipho Mavhungu | ST10121100</span>
            <button class="btn btn-sm btn-outline-primary ms-3" @onclick="ToggleHelp" aria-expanded="@showHelp">
                How to use
            </button>
        </div>

        <article class="content px-4">
            @if (showHelp)
            {
                <section class="help-panel mb-4" aria-label="How to use Smart-X">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h5 mb-1">New to Smart-X? Start here</h2>
                            <p class="text-secondary mb-3">You do not need to understand the technical terms to use the dashboard. Follow these three steps first.</p>

                            <div class="row row-cols-1 row-cols-lg-3 g-3 mb-3">
                                <div class="col">
                                    <div class="border rounded p-3 h-100 bg-white">
                                        <strong class="d-block mb-1">1. See what needs attention</strong>
                                        <span>Open <strong>Command stream</strong>. Red cards are urgent problems; the latest sensor readings appear beside them.</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="border rounded p-3 h-100 bg-white">
                                        <strong class="d-block mb-1">2. Understand the problem</strong>
                                        <span>Open <strong>Telemetry</strong> and select <strong>Investigate</strong> on an alert. You will see the affected device and its reading history.</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <div class="border rounded p-3 h-100 bg-white">
                                        <strong class="d-block mb-1">3. Take a safe action</strong>
                                        <span>Return to <strong>Command stream</strong>, choose an actuator, send a manual override, and use <strong>Undo latest</strong> if you need to reverse it.</span>
                                    </div>
                                </div>
                            </div>

                            <details>
                                <summary class="fw-semibold">What does each menu item do?</summary>
                                <ul class="mt-2 mb-0 ps-3">
                                    <li><strong>Gateway:</strong> the starting page for opening any Smart-X workspace.</li>
                                    <li><strong>Telemetry:</strong> register a device, inspect its readings, and attach supporting files.</li>
                                    <li><strong>Command stream:</strong> watch incoming readings, urgent alerts, suggestions, and manual controls.</li>
                                    <li><strong>Network topology:</strong> view which devices are connected. Use it when you need to check whether a device can still reach the gateway.</li>
                                </ul>
                            </details>

                            <details class="mt-2">
                                <summary class="fw-semibold">Safe practice mode</summary>
                                <p class="mt-2 mb-0">The project includes simulated equipment. On <strong>Network topology</strong>, choose a non-gateway device and select <strong>Toggle status</strong> to simulate it going offline. Then select <strong>Analyse connectivity</strong> to see which devices remain connected. Select <strong>Toggle status</strong> again to bring it back online.</p>
                            </details>
                        </div>
                        <button class="btn-close" aria-label="Close help" @onclick="ToggleHelp"></button>
                    </div>
                </section>
            }
            @Body
        </article>
    </main>
</div>

@code {
    private bool showHelp;

    private void ToggleHelp()
    {
        showHelp = !showHelp;
    }
}
